{
  "_test_metadata": {
    "test_case_id": "19-duplicate-bssids-test",
    "description": "Test handling of same BSSID appearing in both CONNECTED and SCAN results",
    "category": "edge-cases",
    "filtering_config": {
      "mobile_hotspot_filtering_enabled": false
    },
    "expected_results": {
      "total_output_records": 4,
      "connected_records": 2,
      "scan_records": 2,
      "filtered_count": 0,
      "expected_aps": [
        {
          "bssid": "b8:f8:53:c0:1e:ff",
          "connection_status": "CONNECTED",
          "expected_fields": {
            "ssid": "NetworkA",
            "quality_weight": 2.0,
            "comment": "Primary CONNECTED record for this BSSID"
          }
        },
        {
          "bssid": "b8:f8:53:c0:1e:ff",
          "connection_status": "SCAN",
          "expected_fields": {
            "ssid": "NetworkA",
            "quality_weight": 1.0,
            "comment": "Same BSSID also appears in SCAN - should have separate record"
          }
        },
        {
          "bssid": "aa:bb:cc:dd:ee:11",
          "connection_status": "CONNECTED",
          "expected_fields": {
            "ssid": "NetworkB",
            "quality_weight": 2.0
          }
        },
        {
          "bssid": "aa:bb:cc:dd:ee:22",
          "connection_status": "SCAN",
          "expected_fields": {
            "ssid": "NetworkC",
            "quality_weight": 1.0,
            "comment": "Unique SCAN-only BSSID"
          }
        }
      ]
    }
  },
